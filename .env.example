# ScaleEzy POS -- backend environment
#
# Copy to .env and fill in. Every variable here is validated at boot (src/config/env.ts):
# a missing or malformed one refuses to start rather than 500ing on a cashier's first sale.

NODE_ENV=development
PORT=4007

# The POS's OWN database -- not Inventory's. The POS never writes to Inventory's database;
# everything it needs from there comes through the Gateway.
DATABASE_URL="postgresql://user:password@host:5432/pos?schema=public"
# Declared as directUrl in prisma/schema.prisma. Migrations use it; the app does not.
DIRECT_URL="postgresql://user:password@host:5432/pos?schema=public"

# Signs the till's own session tokens when AUTH_MODE=local.
JWT_SECRET=

# CORS allow-list for the till client.
FRONTEND_URL=http://localhost:5175

# local   = the POS issues and verifies its own tokens (standalone client, or local dev)
# gateway = the Gateway authenticates and the POS verifies its RS256 assertion
AUTH_MODE=local
GATEWAY_PUBLIC_KEY_PATH=dev-keys/gateway-public.pem

# Where Inventory is reached, when the client has that module. Absent means standalone mode:
# the POS uses its own item and customer lists and takes no holds.
INVENTORY_BASE_URL=
# The POS's own signing key for service-to-service calls out to Inventory.
POS_PRIVATE_KEY_PATH=dev-keys/pos-private.pem

# Turns off the webhook dispatcher and any scheduled work in THIS process. Set it on a second
# instance pointed at the same database -- two dispatchers claim the same deliveries.
DISABLE_BACKGROUND_JOBS=false

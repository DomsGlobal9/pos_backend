{
  "name": "pos-service",
  "version": "1.0.0",
  "description": "ScaleEzy POS Microservice -- the till",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && prisma migrate deploy && tsc",
    "migrate:deploy": "prisma migrate deploy",
    "verify:money": "ts-node src/scripts/verify-money.ts",
    "verify:sale": "ts-node src/scripts/verify-sale.ts",
    "seed:dev": "ts-node src/scripts/seed-dev.ts",
    "db:local": "node src/scripts/local-db.mjs start",
    "verify:bills": "ts-node src/scripts/verify-bills.ts",
    "verify:payments": "ts-node src/scripts/verify-payments.ts",
    "verify:variants": "ts-node src/scripts/verify-variants.ts",
    "verify:customers": "ts-node src/scripts/verify-customers.ts",
    "verify:approvals": "ts-node src/scripts/verify-approvals.ts",
    "verify:orders": "ts-node src/scripts/verify-orders.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "verify:held-bills": "ts-node src/scripts/verify-held-bills.ts",
    "verify:returns": "ts-node src/scripts/verify-returns.ts",
    "verify:shifts": "ts-node src/scripts/verify-shifts.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "4.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}

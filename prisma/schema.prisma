// ScaleEzy POS -- the till's own database.
//
// The POS owns the SALE: the moment money changes hands. Inventory owns the GOODS. This database
// holds sales, lines, payments, returns, credit notes, held bills, shifts and day closes -- and,
// for a standalone client with no Inventory module, a minimal item and customer list too. It never
// holds stock levels, purchase orders or costs, and this service never writes to Inventory's
// database: everything it needs from there comes through the Gateway.
//
// FOUR THINGS IN HERE ARE DELIBERATE AND EXPENSIVE TO RETROFIT. They are done now, in the first
// migration, while the tables are empty:
//
//   1. MONEY IS ALWAYS Int PAISE. Never Float, never Decimal-as-float. A till adds, splits and
//      rounds money thousands of times a day; a half-paise error becomes a drawer that does not
//      balance, and a cashier who stops trusting the software.
//   2. INVOICE NUMBERS come from InvoiceSeries, allocated inside the same transaction that saves
//      the sale. Unbroken, per financial year, per shop, never reused, never skipped. A gap in the
//      series is a question the shop has to answer to a tax officer.
//   3. EVERY SALE AND RETURN CARRIES onceKey, holdId AND holdConfirmedAt. The first makes a retry
//      harmless; the other two make an unconfirmed sale findable. Without them a sale that
//      committed here but was never confirmed by Inventory is invisible -- finished from the till's
//      point of view and never heard of by Inventory. Inventory has paid for that lesson once
//      already: its previous outbox stranded 747 events because a claim had no lease.
//   4. irn, ackNo AND signedQr EXIST AND ARE NULL. e-invoicing starts above Rs 5 crore turnover and
//      no client is there yet, so none of it is built -- but the columns cost nothing empty and
//      adding them to a live sales table later is the expensive version.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------------------------
// Who is at the till
// ---------------------------------------------------------------------------------------------

/// Local RBAC. Present even when the Gateway authenticates, because the Gateway proves WHO someone
/// is and this database decides WHAT they may do here -- overriding a price, refunding, closing the
/// day. A till that asked the Gateway for permissions on every keystroke would not meet its latency
/// budget, and a shop whose line is down must still be able to sell.
model User {
  id       String     @id @default(uuid())
  clientId String     @map("client_id")
  name     String?
  email    String?
  phone    String?
  status   UserStatus @default(ACTIVE)

  /// Only set when AUTH_MODE=local. Under gateway auth the Gateway holds the credential.
  passwordHash String? @map("password_hash")

  /// A MANAGER'S OVERRIDE PIN, hashed. POS-APR-001.
  ///
  /// Separate from the password on purpose, and it is the whole mechanism behind "no cashier
  /// logout": the manager walks to the till, types four digits, and walks away. The cashier keeps
  /// their session, their basket and the customer standing in front of them.
  ///
  /// Making them sign in properly instead would mean logging the cashier out mid-sale, which is
  /// exactly what MASTER.md forbids -- and in a real shop it means the manager's password gets
  /// written on a sticky note by the till within a week.
  ///
  /// Null for anyone who cannot approve anything, which is most people.
  approvalPinHash String? @map("approval_pin_hash")

  roles           UserRole[]
  shifts          Shift[]
  sales           Sale[]
  returns         Return[]
  dayCloses       DayClose[]
  paymentsChecked   Payment[]  @relation("PaymentCheckedBy")
  approvalsRequested Approval[] @relation("ApprovalRequestedBy")
  approvalsGiven     Approval[] @relation("ApprovalApprovedBy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([clientId, email])
  @@index([clientId])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Role {
  id       String  @id @default(uuid())
  clientId String? @map("client_id")
  name     String
  /// Seeded roles (OWNER, MANAGER, CASHIER) cannot be edited or deleted by a client.
  isSystem Boolean @default(false) @map("is_system")

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, name])
  @@map("roles")
}

/// Permission keys are rows, not an enum. Adding a permission must never need a migration against
/// a table another deployment is already reading -- that mistake took Inventory's alerts endpoint
/// down on 23 Sep 2026.
model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------------------------
// The shop, its counters and its numbering
// ---------------------------------------------------------------------------------------------

/// Per-client till settings. One row per shop.
model ShopSettings {
  clientId String @id @map("client_id")

  shopName       String  @map("shop_name")
  gstin          String?
  address        String?
  logoUrl        String? @map("logo_url")
  receiptFooter  String? @map("receipt_footer")
  invoicePrefix  String  @default("INV") @map("invoice_prefix")
  creditNotePrefix String @default("CN") @map("credit_note_prefix")

  /// Cash / UPI / Card / Points / Credit each on or off for this shop.
  enabledPaymentMethods PaymentMethod[] @map("enabled_payment_methods")

  /// The most a cashier may take off a bill by hand without a manager. Percent.
  manualDiscountMaxPercent Int @default(0) @map("manual_discount_max_percent")
  /// Days after a sale within which a return needs no approval.
  returnWindowDays         Int @default(7) @map("return_window_days")

  /// At or below this many on hand, the till takes a live hold from Inventory before it commits;
  /// above it, it sells optimistically and lets Inventory reconcile. One number, deliberately,
  /// because it also decides when the sell screen may honestly say "last one" -- two numbers would
  /// drift apart. A shop that has been burned turns it up.
  holdThresholdQty Int @default(3) @map("hold_threshold_qty")

  /// The shop's UPI ID, for a QR with the amount already in it. POS-PAY-012. Null: no QR offered.
  upiId String? @map("upi_id")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

/// A physical till. Two on a Saturday share one invoice series and close together.
model Counter {
  id       String  @id @default(uuid())
  clientId String  @map("client_id")
  name     String
  active   Boolean @default(true)

  sales     Sale[]
  heldBills HeldBill[]
  devices   Device[]
  shifts    Shift[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, name])
  @@index([clientId])
  @@map("counters")
}

/// The invoice series, one row per shop per financial year.
///
/// A number is taken with a single conditional UPDATE inside the transaction that writes the sale
/// (`UPDATE ... SET last_number = last_number + 1 ... RETURNING last_number`), so two tills
/// pressing Complete in the same millisecond get 41 and 42 rather than both getting 41. Read it,
/// then write it, and they both get 41.
///
/// Indian financial years run April to March, so the year is stored as the label a shop and its
/// accountant use ("2026-27") rather than a calendar year.
model InvoiceSeries {
  id            String @id @default(uuid())
  clientId      String @map("client_id")
  financialYear String @map("financial_year")
  kind          SeriesKind

  prefix     String
  lastNumber Int    @default(0) @map("last_number")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, financialYear, kind])
  @@map("invoice_series")
}

enum SeriesKind {
  /// Sales invoices.
  INVOICE
  /// Credit notes for returns. A separate series is a GST requirement, not a nicety.
  CREDIT_NOTE
}

// ---------------------------------------------------------------------------------------------
// The customer
// ---------------------------------------------------------------------------------------------

/// The phone number is the identity, and it is unique per shop.
///
/// A sale is still possible with NO customer at all -- someone paying cash who will not give a
/// number. This rule governs customer records, not whether a sale can happen.
///
/// When the client also has Inventory, Inventory is master of this list and these rows are a cache
/// keyed by the same phone number. In standalone mode this IS the list.
model Customer {
  id       String  @id @default(uuid())
  clientId String  @map("client_id")
  phone    String
  name     String?
  gstin    String?

  /// WHO OWNS THESE DEPENDS ON THE MODE, and the difference decides whether they may be SPENT.
  ///
  /// Standalone (today): the POS owns them outright, and spending one is guarded here the way
  /// Inventory guards its own -- a row lock plus a balance check in the same statement.
  ///
  /// With CRM on (not yet built): these become a mirror for display only. A balance moves from
  /// outside the till -- a colleague processing the same customer's exchange is enough -- so the
  /// cached figure is precisely the one that is wrong, and paying with POINTS or CREDIT must take
  /// a live hold. See Sale.holdId and docs/product/CONTRACTS.md §1.1.
  loyaltyPoints    Int @default(0) @map("loyalty_points")
  storeCreditPaise Int @default(0) @map("store_credit_paise")

  /// MARKETING CONSENT. POS-CUST-006.
  ///
  /// Only ever turned ON at a till, when the cashier ticks that the customer agreed. A counter
  /// screen WITHOUT the tick is not the customer saying no -- it is usually nobody having asked --
  /// so this is never set back to false from here. Withdrawing consent is a deliberate act and
  /// belongs where a person can act on a request to stop, not in a sale flow.
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  consentAt        DateTime? @map("consent_at")

  /// Free-text, for what the shop remembers about someone. "Prefers cotton", "sister of Priya".
  note String?

  sales         Sale[]
  returns       Return[]
  creditEntries StoreCreditEntry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([clientId, phone])
  @@index([clientId])
  /// Finding someone by name when they cannot remember which number they gave.
  @@index([clientId, name])
  @@map("customers")
}

// ---------------------------------------------------------------------------------------------
// What there is to sell
// ---------------------------------------------------------------------------------------------

/// STANDALONE MODE ONLY, plus the offline cache.
///
/// A client who has bought Inventory leaves this table effectively unused: the till reads products
/// through the Gateway and keeps the answers here as a cache, because the item list changes rarely
/// and a scan cannot afford a round trip. A client with only the POS fills it by CSV import, by the
/// public API, or by hand.
///
/// No cost price, ever. It is not needed to sell and it must not be on a screen a cashier can show
/// a customer.
model Item {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  code    String
  barcode String?
  name    String
  colour  String?
  size    String?
  hsn     String?

  /// GST-inclusive, in paise. The price on the tag is the price paid -- that decision is settled
  /// and carried over from the counter sale that ran inside Inventory.
  pricePaise Int @map("price_paise")
  /// Percent, e.g. 5 or 12. The bill still shows the CGST/SGST split; this is the rate it splits.
  taxRate    Int @default(0) @map("tax_rate")

  /// A picture, when there is one. POS-SELL-007.
  ///
  /// Worth more on a phone than at a counter: a salesperson showing a customer what is in stock
  /// is looking at the screen with them. A URL rather than a blob -- the POS is not an image host,
  /// and with Inventory on, this mirrors whatever Inventory already serves.
  imageUrl String? @map("image_url")

  /// Groups items that are the same thing in different colours or sizes, so the sell screen can
  /// offer a picker instead of five near-identical search results. POS-SELL-006.
  ///
  /// In standalone mode the shop sets it (or it is derived from the name on import). With
  /// Inventory on, it carries Inventory's product identity. Null means this item stands alone,
  /// which is the common case for a one-off piece.
  variantGroup String? @map("variant_group")

  /// Inventory's variant id, when this row is a cache of an Inventory product. Null in standalone
  /// mode. Third parties and the public API address items by `code`, never by either uuid, so a
  /// client's own software is not coupled to our primary keys.
  inventoryVariantId String? @map("inventory_variant_id")

  /// Last known quantity at this store, and when it was read. Advisory only: the sell screen shows
  /// it so an assistant can say "last one" honestly, and it decides whether a hold is needed. It is
  /// never the authority, and a sale is never blocked because it is stale.
  cachedQty     Int?      @map("cached_qty")
  cachedQtyAt   DateTime? @map("cached_qty_at")

  active Boolean @default(true)

  saleLines SaleLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, code])
  @@unique([clientId, barcode])
  @@index([clientId])
  @@index([clientId, inventoryVariantId])
  @@index([clientId, variantGroup])
  @@map("items")
}

// ---------------------------------------------------------------------------------------------
// The sale
// ---------------------------------------------------------------------------------------------

model Sale {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// Allocated from InvoiceSeries inside this sale's own transaction. Unbroken, per financial year.
  invoiceNo     String @map("invoice_no")
  financialYear String @map("financial_year")

  counterId String  @map("counter_id")
  cashierId String? @map("cashier_id")
  /// The shift open on this counter when the bill was made. POS-SHIFT-002. Null: none was open.
  shiftId   String? @map("shift_id")

  kind   SaleKind
  /// The MONEY view: is anything still owed. BALANCE_DUE or COMPLETED.
  status SaleStatus @default(COMPLETED)

  /// The GOODS view: where the saree is. POS-ORD-006, -007, -014.
  ///
  /// Two separate questions, deliberately kept in two columns. An order can be ready and still owe
  /// money, or paid in full and still at the tailor's. Folding them into one status is how a shop
  /// ends up with "READY_BALANCE_DUE_PARTIALLY_COLLECTED" -- and a cashier who cannot tell what
  /// to do next.
  ///
  /// A COMPLETE sale is handed over at the counter, so it defaults to HANDED_OVER and never
  /// changes. Only a KEPT order moves through WAITING and READY.
  fulfilment Fulfilment @default(HANDED_OVER)

  /// When the customer was told to come back. POS-ORD-004.
  promisedAt DateTime? @map("promised_at")
  /// What the shop needs to remember. "Fall and pico, blouse to be stitched". POS-ORD-005.
  note       String?

  readyAt        DateTime? @map("ready_at")
  handedOverAt   DateTime? @map("handed_over_at")
  handedOverById String?   @map("handed_over_by_id")
  /// What was still owed at the moment the goods left, when anything was. POS-ORD-013.
  ///
  /// Recorded because handing over with money due is a decision someone made, and a shop owner
  /// chasing that money later needs to know who decided it and how much it was at the time.
  handoverDuePaise Int? @map("handover_due_paise")

  customerId String? @map("customer_id")

  /// Every figure in paise. subtotal is before discount and after nothing else; total is what was
  /// actually asked for, after discount, tax and rounding.
  subtotalPaise Int @map("subtotal_paise")
  discountPaise Int @default(0) @map("discount_paise")
  taxPaise      Int @default(0) @map("tax_paise")
  roundOffPaise Int @default(0) @map("round_off_paise")
  totalPaise    Int @map("total_paise")
  /// What the customer was shown as saved. Shown on the receipt, because it is the cheapest
  /// loyalty tool there is.
  savedPaise    Int @default(0) @map("saved_paise")

  /// IDEMPOTENCY. The till makes one key per basket. Pressing Complete twice, a retry after a
  /// timeout, and the offline outbox flushing the same bill are three names for one problem, and
  /// this is the answer to all three: unique, and the second attempt returns the first sale rather
  /// than making a second one. Inventory solves it the same way, with once_key on every money row.
  onceKey String @unique @map("once_key")

  /// THE HOLD THIS SALE COMMITTED AGAINST, and when Inventory confirmed it.
  ///
  /// A capped offer, the last few of a variant, a customer's loyalty points and their store credit
  /// are all limited, and all four are guarded inside a single transaction when the sale happens in
  /// Inventory. Across two databases that is impossible, so the till takes a short-lived hold from
  /// Inventory first and commits against it.
  ///
  /// holdId set and holdConfirmedAt null IS THE RECONCILE QUEUE. Without these two columns such a
  /// sale is invisible. A hold that expires unconfirmed is Inventory's to release.
  ///
  /// Both null means nothing limited was involved -- an ordinary basket of plentiful stock paid for
  /// in cash, sold optimistically, which is the common case and must stay fast.
  holdId          String?   @map("hold_id")
  holdConfirmedAt DateTime? @map("hold_confirmed_at")

  /// e-invoicing, above Rs 5 crore turnover. Not built. Not null-checked anywhere yet.
  irn      String? @map("irn")
  ackNo    String? @map("ack_no")
  signedQr String? @map("signed_qr")

  /// Set when the bill was made offline, so a day close can say so plainly.
  madeOfflineAt DateTime? @map("made_offline_at")

  /// How many times this bill has been printed, and when it last was. POS-RCPT-004.
  ///
  /// A reprint must be MARKED as a duplicate on the paper. Two identical-looking copies of the
  /// same invoice is how a customer returns the same saree twice, and how a shop's own staff
  /// lose track of which copy the accountant has. The first print is the original; every one
  /// after it says so.
  printCount    Int       @default(0) @map("print_count")
  /// The digital receipt's address: /r/<token>. POS-RCPT-009. Random and unguessable -- it is the
  /// only thing standing between a stranger and the bill -- and made the first time it is needed.
  receiptToken  String?   @unique @map("receipt_token")
  lastPrintedAt DateTime? @map("last_printed_at")

  shift     Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  lines     SaleLine[]
  payments  Payment[]
  returns   Return[] @relation("ReturnOriginalSale")
  /// Set on the NEW bill of an exchange: the return whose credit paid for part of it. POS-EXC-005.
  exchangedFrom Return[] @relation("ReturnExchangeSale")
  approvals Approval[]

  counter  Counter   @relation(fields: [counterId], references: [id])
  cashier  User?     @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, invoiceNo])
  @@index([clientId, createdAt])
  @@index([clientId, status])
  /// The Orders screen: kept orders by where they are.
  @@index([clientId, kind, fulfilment])
  @@index([counterId])
  @@index([customerId])
  @@index([holdId])
  @@map("sales")
}

enum SaleKind {
  /// Paid for and taken away.
  COMPLETE
  /// Kept for the customer -- part payment now, balance later, goods held or handed over.
  KEPT
}

enum Fulfilment {
  /// Kept for the customer, not ready yet -- at the tailor's, being fall-pico'd, being altered.
  WAITING
  /// Ready. The customer can come and collect.
  READY
  /// Gone. Every COMPLETE sale is this from the moment it is made.
  HANDED_OVER
}

enum SaleStatus {
  COMPLETED
  /// A KEPT sale with money still owed.
  BALANCE_DUE
  /// Fully returned. A partly returned sale stays COMPLETED; its lines carry the detail.
  RETURNED
  /// Made offline, not yet accepted by the server. Only ever set by the outbox flush.
  PENDING_SYNC
}

model SaleLine {
  id     String @id @default(uuid())
  saleId String @map("sale_id")

  /// Null when the line was typed rather than scanned, or when a standalone shop sells something
  /// not in its item list. The description, price and tax are copied onto the line either way: a
  /// bill must read the same in five years even if the item is renamed or deleted.
  itemId String? @map("item_id")
  /// Inventory's variant id, so `sale.completed` can tell Inventory what left the shelf.
  inventoryVariantId String? @map("inventory_variant_id")

  description String
  hsn         String?
  qty         Int
  unitPricePaise Int @map("unit_price_paise")
  discountPaise  Int @default(0) @map("discount_paise")
  taxRate        Int @default(0) @map("tax_rate")
  taxPaise       Int @default(0) @map("tax_paise")
  lineTotalPaise Int @map("line_total_paise")

  /// The tax split AS IT WAS CHARGED, stored rather than worked out again when the bill is
  /// reprinted. The odd paisa of an odd tax has to go to one side or the other, and if that rule
  /// ever changes -- or an invoice is reprinted by a newer build -- a recomputed split would make
  /// the reprint disagree with the original. A GST invoice has to say the same thing in five
  /// years as it said at the counter, so this is copied onto the line like the description is.
  cgstPaise Int @default(0) @map("cgst_paise")
  sgstPaise Int @default(0) @map("sgst_paise")
  igstPaise Int @default(0) @map("igst_paise")

  /// Which offers touched this line, and what each took off. Frozen at the moment of sale: the
  /// rules may change tomorrow, but this bill was priced under today's.
  appliedOffers Json? @map("applied_offers")

  /// Set with a reason when someone overrode the shelf price. Permission-gated, approved, and
  /// audited -- the single most abused feature in any POS.
  priceOverrideReason String? @map("price_override_reason")

  /// What the tag actually said, kept beside what was charged.
  ///
  /// Without this, an override is invisible after the fact: the line simply shows a price, and
  /// nobody can tell it was not the shelf price. With it, a margin report can show exactly how
  /// much was given away and by whom.
  listPricePaise Int? @map("list_price_paise")

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item        Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  returnLines ReturnLine[]

  @@index([saleId])
  @@index([itemId])
  @@map("sale_lines")
}

model Payment {
  id       String  @id @default(uuid())
  clientId String  @map("client_id")
  saleId   String  @map("sale_id")

  method      PaymentMethod
  amountPaise Int           @map("amount_paise")
  /// UPI transaction reference, card approval code, or the cheque number.
  reference   String?

  /// Cash tendered and change given, for the CASH part of a split. Recorded because getting change
  /// wrong loses real money, and a drawer that is short needs the evidence.
  tenderedPaise Int? @map("tendered_paise")
  changePaise   Int? @map("change_paise")

  /// Same idempotency rule as the sale: one key per payment attempt.
  onceKey String @unique @map("once_key")

  /// The drawer this money went into. POS-SHIFT-005. Set on the PAYMENT rather than read from the
  /// sale, because a kept order's balance is collected days later -- into whichever drawer is open
  /// then, not the one the order was taken at. Null when no shift was open: reported, not hidden.
  shiftId String? @map("shift_id")
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  /// Collected later against a KEPT sale, rather than at the moment of sale.
  collectedAt DateTime? @map("collected_at")

  /// WHETHER THE MONEY IS ACTUALLY IN. POS-PAY-010.
  ///
  /// The rule this column exists to enforce: never treat an ambiguous payment as failed and ask
  /// the customer to pay again. A UPI transfer the shop's phone has not announced yet, or one day
  /// a provider call that times out mid-charge, may well have taken the money. Asking for it twice
  /// is the worst thing a till can do -- worse than a slow sale, worse than a wrong total, because
  /// the shop looks like it is stealing.
  ///
  /// So an uncertain payment is recorded as NEEDS_CHECKING, the sale completes (the customer is
  /// leaving with the goods either way), and someone resolves it against the bank afterwards.
  status PaymentStatus @default(COLLECTED)

  /// Set when a NEEDS_CHECKING payment was resolved: when, by whom, and what they found.
  checkedAt   DateTime? @map("checked_at")
  checkedById String?   @map("checked_by_id")
  checkedNote String?   @map("checked_note")

  sale      Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  checkedBy User? @relation("PaymentCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  /// Defaulted as well as @updatedAt, so the column can be added to a table that already has rows
  /// without inventing a NOT NULL with nothing in it. Housekeeping only -- no financial fact is
  /// reinterpreted by backfilling it.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([clientId, createdAt])
  @@index([saleId])
  /// Finding everything still waiting to be checked, without scanning the table.
  @@index([clientId, status])
  @@map("payments")
}

enum PaymentStatus {
  /// The money is in. The ordinary case, and the default.
  COLLECTED
  /// It MIGHT be in. Never re-charge on the strength of this -- check the bank first.
  NEEDS_CHECKING
  /// Checked, and the money never arrived. The bill is short by this much.
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  /// Store credit the shop owed this customer.
  CREDIT
  /// Loyalty points spent as money.
  POINTS
  /// A KEPT sale's outstanding balance. Not money received -- the line that makes the bill add up.
  BALANCE
  /// Goods brought back in the same exchange, standing in for money on the new bill. POS-EXC-004.
  /// Never sent by a till: only the exchange path writes it, and the return it came from is the
  /// credit note that says so.
  EXCHANGE
}

// ---------------------------------------------------------------------------------------------
// Returns and exchanges
// ---------------------------------------------------------------------------------------------

/// Clothing lives on exchanges, so this has to be as fast as a sale.
model Return {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  /// Its own series, per financial year. A GST requirement.
  creditNoteNo  String @map("credit_note_no")
  financialYear String @map("financial_year")

  originalSaleId String @map("original_sale_id")
  cashierId      String? @map("cashier_id")

  reason       String
  refundMethod RefundMethod @map("refund_method")
  totalPaise   Int          @map("total_paise")

  /// An exchange is a return and a sale settling only the difference. This points at the new sale.
  exchangeSaleId String? @map("exchange_sale_id")

  /// Same three columns, same reasons as on Sale -- an exchange both releases a hold and takes one.
  onceKey         String    @unique @map("once_key")
  holdId          String?   @map("hold_id")
  holdConfirmedAt DateTime? @map("hold_confirmed_at")

  /// Set when a manager allowed this return, and by whom. Null when it was the person's own right.
  approvedById String? @map("approved_by_id")

  /// Who the store credit went to. Usually the bill's own customer; set at the return when the
  /// original bill had none -- a cash buyer who gave no number is still owed their credit.
  customerId String? @map("customer_id")

  /// The tax inside totalPaise, taken back out. A credit note has to show it -- it reverses GST.
  taxPaise      Int @default(0) @map("tax_paise")
  /// Only ever non-zero on the return that empties a bill: the original bill's round-off comes
  /// back with the last piece, so everything returned adds up to exactly what was paid.
  roundOffPaise Int @default(0) @map("round_off_paise")

  lines     ReturnLine[]
  refunds   ReturnRefund[]
  approvals Approval[]

  originalSale Sale      @relation("ReturnOriginalSale", fields: [originalSaleId], references: [id])
  exchangeSale Sale?     @relation("ReturnExchangeSale", fields: [exchangeSaleId], references: [id])
  cashier      User?     @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clientId, creditNoteNo])
  @@index([clientId, createdAt])
  @@index([originalSaleId])
  @@index([exchangeSaleId])
  @@index([customerId])
  @@index([holdId])
  @@map("returns")
}

/// Money going back out on a return. POS-RET-007, POS-PAY-015.
///
/// Rows, like payments, rather than one column on the return, because an exchange can need two
/// answers: part of the credit settles the new bill and the rest goes back as cash. Day close
/// (Phase 7) sums these by method to say what left the drawer.
model ReturnRefund {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  returnId String @map("return_id")

  method      RefundMethod
  amountPaise Int          @map("amount_paise")
  /// The UPI or card refund's own reference. Required for those, as on a payment.
  reference   String?

  /// The drawer a cash refund came out of. Null when no shift was open.
  shiftId String? @map("shift_id")
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  returnRow Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([returnId])
  @@index([clientId, createdAt])
  @@map("return_refunds")
}

/// Every change to a customer's store credit. POS-CUST-012, POS-PAY-016.
///
/// The balance on Customer is what gets checked and locked; this is how anyone finds out why it
/// is what it is. Written in the same transaction as the change, never after.
model StoreCreditEntry {
  id         String @id @default(uuid())
  clientId   String @map("client_id")
  customerId String @map("customer_id")

  /// Positive when the shop owes more (a return), negative when it is spent.
  amountPaise       Int @map("amount_paise")
  balanceAfterPaise Int @map("balance_after_paise")

  returnId String? @map("return_id")
  saleId   String? @map("sale_id")
  byId     String? @map("by_id")

  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([clientId, createdAt])
  @@map("store_credit_entries")
}

enum RefundMethod {
  CASH
  UPI
  CARD
  /// Held against the phone number, to be spent in the shop.
  STORE_CREDIT
  /// Settled against the goods taken instead -- an exchange.
  EXCHANGE
}

model ReturnLine {
  id       String @id @default(uuid())
  returnId String @map("return_id")

  saleLineId String @map("sale_line_id")
  qty        Int
  /// This line's share of what was actually paid for it, tax included. Worked out cumulatively
  /// (see services/returns) so returning a line one piece at a time adds up to the line exactly.
  amountPaise Int   @map("amount_paise")
  /// The tax inside amountPaise, split the same way the original line was.
  taxPaise   Int @default(0) @map("tax_paise")
  cgstPaise  Int @default(0) @map("cgst_paise")
  sgstPaise  Int @default(0) @map("sgst_paise")
  igstPaise  Int @default(0) @map("igst_paise")

  returnRow Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleLine  SaleLine @relation(fields: [saleLineId], references: [id])

  @@index([returnId])
  @@index([saleLineId])
  @@map("return_lines")
}

// ---------------------------------------------------------------------------------------------
// Parking a bill
// ---------------------------------------------------------------------------------------------

/// A customer goes back for another saree and someone is waiting. Park the bill, serve the next
/// person, bring it back.
///
/// Held on the server, not only in the browser, for two reasons: it must survive a refresh and a
/// browser crash, and it belongs to the shift rather than to one cashier -- whoever is free
/// finishes it.
model HeldBill {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  counterId String @map("counter_id")
  /// What the cashier will recognise it by: a name, "blue saree lady", a token number.
  label     String

  /// The basket as the screen had it. Json because a parked bill is a draft, not a record: it has
  /// no invoice number, has taken no hold, and has moved no stock.
  payload Json

  createdById String?  @map("created_by_id")
  counter     Counter  @relation(fields: [counterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, counterId])
  @@map("held_bills")
}

// ---------------------------------------------------------------------------------------------
// The shift and the day
// ---------------------------------------------------------------------------------------------

/// The feature that makes an owner trust the software.
model Shift {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  counterId String  @map("counter_id")
  cashierId String? @map("cashier_id")

  openedAt        DateTime  @default(now()) @map("opened_at")
  openingCashPaise Int      @map("opening_cash_paise")

  closedAt         DateTime? @map("closed_at")
  /// What the software says should be in the drawer.
  expectedCashPaise Int?     @map("expected_cash_paise")
  /// What the cashier counted. Typed in, not calculated -- the point of the exercise.
  countedCashPaise  Int?     @map("counted_cash_paise")
  /// counted - expected. Negative is short. Recorded either way, never silently corrected.
  differencePaise   Int?     @map("difference_paise")
  closingNote       String?  @map("closing_note")
  /// Who closed it. A cashier closes their own; anyone else's needs the day-close right.
  closedById        String?  @map("closed_by_id")

  counter Counter @relation(fields: [counterId], references: [id])
  cashier User?   @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  /// Everything that moved cash in this drawer while it was open. Expected cash is derived from
  /// these every time it is asked for -- never kept as a running total that could drift.
  sales     Sale[]
  payments  Payment[]
  refunds   ReturnRefund[]
  movements CashMovement[]

  @@index([clientId, openedAt])
  @@index([counterId, closedAt])
  @@map("shifts")
}

enum CashDirection {
  /// Change float topped up, a supplier's refund in cash -- money INTO the drawer that is not a sale.
  IN
  /// Tea, courier, petty expenses, a bank deposit -- money OUT that is not a refund.
  OUT
}

/// Cash into or out of the drawer that is not a sale or a refund. POS-SHIFT-003, -004.
///
/// Every one names an amount, a reason and a person. "The drawer is Rs 400 short" is a question the
/// owner asks weeks later, and the only good answer is a row that says "Rs 400 out, courier, Ravi,
/// 3:12 pm".
model CashMovement {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  shiftId  String @map("shift_id")

  direction   CashDirection
  amountPaise Int           @map("amount_paise")
  reason      String

  byId         String? @map("by_id")
  /// Set when a manager's PIN allowed a cashier to take cash out.
  approvedById String? @map("approved_by_id")

  /// A double press records the movement once.
  onceKey String @unique @map("once_key")

  shift Shift @relation(fields: [shiftId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([shiftId])
  @@index([clientId, createdAt])
  @@map("cash_movements")
}

/// A closed day cannot be edited. A correction is a new entry -- the same rule the day book in
/// Inventory follows, so the two keep balancing across the cut-over date.
model DayClose {
  id       String   @id @default(uuid())
  clientId String   @map("client_id")
  /// The trading date, not a timestamp. One row per shop per day, covering every counter.
  date     DateTime @db.Date

  salesCount     Int @default(0) @map("sales_count")
  grossPaise     Int @default(0) @map("gross_paise")
  discountPaise  Int @default(0) @map("discount_paise")
  taxPaise       Int @default(0) @map("tax_paise")
  netPaise       Int @default(0) @map("net_paise")
  returnsPaise   Int @default(0) @map("returns_paise")
  returnsCount   Int @default(0) @map("returns_count")
  /// What should be in the drawer across the day, after opening cash and payouts.
  cashPositionPaise Int @default(0) @map("cash_position_paise")
  openingCashPaise  Int @default(0) @map("opening_cash_paise")
  cashInPaise       Int @default(0) @map("cash_in_paise")
  cashOutPaise      Int @default(0) @map("cash_out_paise")
  /// Summed from the shifts closed that day. Null when none was counted.
  countedCashPaise  Int? @map("counted_cash_paise")
  variancePaise     Int? @map("variance_paise")
  /// Cash taken or refunded with no shift open. Shown so it cannot hide.
  unattributedCashPaise Int @default(0) @map("unattributed_cash_paise")
  /// Shifts still open when the day was closed -- allowed only when someone said so.
  openShiftsAtClose Int @default(0) @map("open_shifts_at_close")
  /// Payments still being checked against the bank when the day closed.
  paymentsToCheck   Int @default(0) @map("payments_to_check")
  note              String?

  /// Amount per payment method. Json because the enabled methods differ per shop and a column per
  /// method would mean a migration every time one is added.
  byMethod Json @map("by_method")

  closedById String?  @map("closed_by_id")
  closedBy   User?    @relation(fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime @default(now()) @map("closed_at")

  @@unique([clientId, date])
  @@map("day_closes")
}

// ---------------------------------------------------------------------------------------------
// Telling other software what happened
// ---------------------------------------------------------------------------------------------

// These three models are PORTED from Inventory's StorefrontConnection / StorefrontEvent /
// StorefrontDelivery rather than designed fresh, because Inventory already paid for the lessons in
// them. Its FIRST outbox read one global webhook URL for every tenant, carried no client id, and
// claimed rows before checking it had somewhere to send them -- which is why all 747 of its events
// are stranded to this day. Four fields below are what a fresh sketch leaves out: `sequence`,
// `eventVersion`, `lockedAt`, and identity by public code rather than by our uuid.

/// A URL a client's own software owns, and which events it wants.
///
/// A standalone client running their own boutique software registers here. So does an Inventory
/// deployment, when the POS has to tell it a sale happened. One client may have several.
model WebhookEndpoint {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  name String
  url  String

  /// The secret is shown once, at creation, and never stored. Only its hash is kept, so a leak of
  /// this table does not hand anyone the ability to impersonate us to a client's software.
  secretHash   String @map("secret_hash")
  /// A short, non-secret prefix, so a credential can be named in the UI and in a log without
  /// printing anything usable.
  secretPrefix String @map("secret_prefix")

  /// Event names this endpoint wants, e.g. ["sale.completed", "day.closed"]. Empty means all.
  events String[]

  active         Boolean   @default(true)
  lastDeliveryAt DateTime? @map("last_delivery_at")

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id String @id @default(uuid())

  /// Monotonic per client. A receiver applies last-writer-wins on this and discards anything older
  /// than it has already applied for the same entity, so events arriving out of order are
  /// self-correcting. Timestamps cannot do this job: two events written in the same millisecond are
  /// unordered, and clocks move.
  sequence BigInt @default(autoincrement())

  clientId String @map("client_id")

  /// A string, not an enum: these names are a public contract that third parties match on, and a
  /// new event must not need a migration on a table other people's integrations read.
  eventType String @map("event_type")
  /// Part of the public contract. An old integration must not break when `payload` grows.
  eventVersion Int @default(1) @map("event_version")

  /// What the event is about, by PUBLIC identity -- invoice number, item code, phone number. Never
  /// an internal uuid: that would couple every client's database to our primary keys.
  invoiceNo String? @map("invoice_no")
  itemCode  String? @map("item_code")

  /// The event body as it will be sent, minus the envelope.
  payload Json

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, sequence])
  @@index([eventType])
  @@map("webhook_events")
}

model WebhookDelivery {
  id         String @id @default(uuid())
  eventId    String @map("event_id")
  endpointId String @map("endpoint_id")
  /// Denormalised so the queue can be made fair per client without a join -- one shop's 400 events
  /// must not starve everyone else's.
  clientId   String @map("client_id")

  status   DeliveryStatus @default(PENDING)
  attempts Int            @default(0)

  nextAttemptAt DateTime? @map("next_attempt_at")
  lastAttemptAt DateTime? @map("last_attempt_at")
  responseCode  Int?      @map("response_code")
  responseBody  String?   @map("response_body")

  /// When a worker claimed this row. A claim older than the lease means the process died mid-send,
  /// so the row is reclaimed rather than stranded. This single column is the difference between
  /// this outbox and the one that stranded 747 events.
  lockedAt DateTime? @map("locked_at")

  deliveredAt DateTime? @map("delivered_at")

  event    WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([clientId, status])
  @@map("webhook_deliveries")
}

enum DeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  /// Retries exhausted. Kept, and re-sendable by hand from the delivery log.
  FAILED
}

// ---------------------------------------------------------------------------------------------
// Someone said yes
// ---------------------------------------------------------------------------------------------

/// A manager allowing something a cashier may not do alone. POS-APR-001..005.
///
/// Three facts, and the record is worthless without all three: WHO ASKED, WHO AGREED, and WHY. A
/// shop owner reading this back a month later is not asking whether a discount was approved --
/// they can see that it was. They are asking who kept approving them, and what reason kept being
/// given.
///
/// Kept as its own row rather than folded into AuditLog because it is referenced: a sale points at
/// the approval that let it happen, so a bill can show the authority it was written under.
model Approval {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  kind   ApprovalKind
  /// Typed by the person asking, not chosen from a list. A dropdown of reasons becomes one reason
  /// selected every time, which tells an owner nothing.
  reason String

  /// What exactly was allowed -- the percentage, the old and new price, the line it applied to.
  /// Frozen here, because the sale it belongs to may be re-priced before it is saved.
  detail Json?

  /// The cashier who asked. Null only if a manager did it themselves.
  requestedById String? @map("requested_by_id")
  /// The manager who typed their PIN. Never null: an approval with no approver is not an approval.
  approvedById  String  @map("approved_by_id")

  /// Set once the sale it authorised is written. Null means the sale was abandoned after the
  /// approval was given -- which is worth being able to see.
  saleId String? @map("sale_id")
  /// Or the return it authorised. POS-APR-004, -005.
  returnId String? @map("return_id")

  createdAt DateTime @default(now()) @map("created_at")

  requestedBy User?   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User    @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  sale        Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  returnRow   Return? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([saleId])
  @@index([returnId])
  @@index([approvedById])
  @@map("approvals")
}

enum ApprovalKind {
  /// A discount larger than the cashier's limit.
  DISCOUNT_OVER_LIMIT
  /// Selling at a price other than the one on the tag.
  PRICE_OVERRIDE
  /// A refund a cashier may not give alone.
  RETURN
  /// A return after the shop's window has closed.
  RETURN_OUTSIDE_WINDOW
  /// A cashier taking cash out of the drawer.
  CASH_OUT
}

// ---------------------------------------------------------------------------------------------
// Who did what
// ---------------------------------------------------------------------------------------------

/// Everything sensitive at a till is logged with who and when: a price override, a discount over
/// the limit, a refund, a day close, a cancelled sale.
model AuditLog {
  id       String @id @default(uuid())
  clientId String @map("client_id")

  actorId   String? @map("actor_id")
  actorName String? @map("actor_name")
  action    String
  /// What it was done to, by public identity where there is one.
  subject   String?
  detail    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// The link to Inventory. Phase 8. See docs/product/INVENTORY-CONTRACT.md.
// ---------------------------------------------------------------------------------------------

/// One row per shop that has connected the till to Inventory. No row: standalone.
///
/// Delivery is a CURSOR, not a queue of rows: the next event to send is the first stock event after
/// `deliveredSequence`. Events are sent one at a time, in order, so a return can never overtake the
/// sale it is against. A failure that needs a person (an unknown item, a bad key) sets `blocked*`
/// and holds everything behind it -- sending the return of a sale Inventory refused would be wrong.
model InventoryLink {
  clientId String @id @map("client_id")

  connected Boolean @default(false)
  /// Where this shop's Inventory is. Defaults to the deployment's INVENTORY_BASE_URL.
  baseUrl   String  @map("base_url")
  /// The connection credential, encrypted (AES-256-GCM, CREDENTIAL_ENCRYPTION_KEY). Never returned.
  keyCipher String  @map("key_cipher")
  /// The first characters, so the owner can tell which key is in use without seeing it.
  keyPrefix String  @map("key_prefix")

  /// SELL: sell anyway when Inventory cannot answer (the default). CHECK_SHELF: ask the cashier.
  whenDown String @default("SELL") @map("when_down")

  /// The last event Inventory accepted. Events at or below this are never sent (again).
  deliveredSequence BigInt    @default(0) @map("delivered_sequence")
  lastDeliveredAt   DateTime? @map("last_delivered_at")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @map("next_attempt_at")
  lastError         String?   @map("last_error")
  /// A lease, so two server instances never send the same event at once.
  lockedUntil       DateTime? @map("locked_until")

  /// Set when an event needs a person. Everything after it waits.
  blockedSequence BigInt? @map("blocked_sequence")
  blockedCode     String? @map("blocked_code")
  blockedMessage  String? @map("blocked_message")

  /// Notes Inventory sent back on bills it ACCEPTED -- a GST rate that differs from the product, a
  /// sale of stock it thought it did not have. Newest first, the last 30. Shown to the owner, never
  /// to a cashier: nothing stopped, but somebody should look.
  recentWarnings Json? @map("recent_warnings")

  catalogueCursor   String?   @map("catalogue_cursor")
  catalogueSyncedAt DateTime? @map("catalogue_synced_at")
  /// What the last sync could not take, in words: fractional GST rates, exclusive prices.
  catalogueProblems Json?     @map("catalogue_problems")

  connectedAt DateTime? @map("connected_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("inventory_links")
}

// ---------------------------------------------------------------------------------------------
// Receipts sent, and the devices the till runs on. Phase 10.
// ---------------------------------------------------------------------------------------------

/// One press of "Send on WhatsApp" (or, later, email/SMS). POS-RCPT-006..008.
///
/// Its own table, written in its own request, AFTER the sale: a receipt that fails to send can
/// never touch the bill (the Phase 10 gate). The recipient is the bill's own customer, decided by
/// the server -- never a number typed into the browser.
model ReceiptSend {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  saleId   String @map("sale_id")

  /// WHATSAPP today. EMAIL and SMS when a provider is chosen.
  channel String
  /// Last four digits only -- the full number stays on the customer record.
  toLast4 String @map("to_last4")

  /// QUEUED (the service took it), SENT, DELIVERED, READ, FAILED.
  status     String
  providerId String? @map("provider_id")
  failReason String? @map("fail_reason")

  byId    String? @map("by_id")
  /// One per press. A double tap sends one message.
  onceKey String  @unique @map("once_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([saleId])
  @@index([clientId, createdAt])
  @@map("receipt_sends")
}

/// A browser the till runs in -- a counter PC, a tablet, a salesperson's phone. POS-DEV-001..004.
///
/// Registered by the device itself on first open (an id it keeps in local storage) and kept fresh
/// by a heartbeat, so the owner can see what is in use, where, on which version, and when each was
/// last seen. A browser cannot see a printer's paper or ink, so "printer" here is what the till
/// prints to (paper width) and when it last printed -- said as that, not dressed up as status.
model Device {
  id       String @id
  clientId String @map("client_id")

  /// "Counter 1 PC", "Ravi's phone". Starts as a guess from the browser; the owner can rename it.
  name      String
  counterId String? @map("counter_id")

  appVersion   String?  @map("app_version")
  userAgent    String?  @map("user_agent")
  /// { camera, cameraScan, touch, screen: "1366x768" }, as the browser reported it.
  capabilities Json?
  /// 80 or 58 (mm). The receipt prints at this width on this device.
  paperWidthMm Int      @default(80) @map("paper_width_mm")

  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  lastUserName  String?   @map("last_user_name")
  lastPrintedAt DateTime? @map("last_printed_at")

  counter Counter? @relation(fields: [counterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, lastSeenAt])
  @@map("devices")
}
